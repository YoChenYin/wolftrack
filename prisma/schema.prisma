// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 市場別，US=美股版，TW=台股版；共用 stocks/sector_mapping/daily_trend_signals，用這個欄位區分
enum Market {
  US
  TW
}

/// 板塊/產業對照表，供板塊選擇器使用（US 用 GICS，TW 用證交所產業分類，各自一套 sectorCode）
model SectorMapping {
  id           Int      @id @default(autoincrement())
  market       Market   @default(US)
  sectorCode   String   @map("sector_code")
  sectorName   String   @map("sector_name")
  sectorNameZh String?  @map("sector_name_zh")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  stocks Stock[]

  @@unique([market, sectorCode])
  @@map("sector_mapping")
}

/// 股票主檔（US + TW 共用）
model Stock {
  id          Int      @id @default(autoincrement())
  market      Market   @default(US)
  ticker      String
  companyName String   @map("company_name")
  sectorId    Int      @map("sector_id")
  industry    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sector                SectorMapping             @relation(fields: [sectorId], references: [id])
  signals               DailyTrendSignal[]
  themes                StockTheme[]
  institutionalTrading  TwInstitutionalTrading[]
  brokerBranchFlow      TwBrokerBranchFlow[]
  dailyPrices           TwDailyPrice[]
  fundamentals          TwStockFundamentals[]
  monthlyRevenues       TwMonthlyRevenue[]
  youtubeMentions       YoutubeStockMention[]
  historyBackfillStatus TwHistoryBackfillStatus[]
  earningsCallAnalyses  EarningsCallAnalysis[]

  @@unique([market, ticker])
  @@index([sectorId])
  @@map("stocks")
}

/// 跨板塊的題材標籤（例如 AI infra、散熱、被動元件、CPO、PCB），一檔股票可以有多個
model Theme {
  id           Int      @id @default(autoincrement())
  themeCode    String   @unique @map("theme_code")
  themeName    String   @map("theme_name")
  themeNameZh  String?  @map("theme_name_zh")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  stocks StockTheme[]

  @@map("themes")
}

/// Stock <-> Theme 多對多關聯表
model StockTheme {
  stockId Int @map("stock_id")
  themeId Int @map("theme_id")

  stock Stock @relation(fields: [stockId], references: [id])
  theme Theme @relation(fields: [themeId], references: [id])

  @@id([stockId, themeId])
  @@map("stock_themes")
}

/// 美股版三段式戰術狀態：反轉雷達 / 蓄勢待發 / 趨勢穩健（src/lib/trend/classify.ts，只有美股在用）。
/// limitMove（台股觸及漲跌停±10%的特殊狀態，不套用一般分類邏輯）在兩個市場的enum裡共用。
/// chipLeading 是舊版台股邏輯（2026-07-09~2026-07-23）留下的歷史值，2026-07-23改版後台股不再產生
/// 新的chipLeading（籌碼流已經是主要訊號來源，不再是技術面之外的次要觀察名單），保留enum值只是
/// 為了不用migration處理歷史資料，新資料不會再寫入。
///
/// 2026-07-23新增：entry / exit / buyDip 是台股版新的籌碼流策略三段式狀態（進場/出場/逢低布局，
/// src/lib/trend/tw/classifyChipFlow.ts），取代台股原本共用的 reversal/pullback/bullish
/// （美股不受影響，繼續用 classify.ts 的舊三段式）。TrendStatus 是兩個市場共用的enum，所以兩組
/// 詞彙都保留在同一個enum裡，各自市場只會產生屬於自己那組的值。
enum TrendStatus {
  reversal
  pullback
  bullish
  limitMove
  chipLeading
  /// 2026-07-23~2026-08-17版籌碼流策略的歷史值，2026-08-17改版後不再產生新資料，見
  /// src/lib/trend/types.ts的TrendStatus說明
  entry
  exit
  buyDip
  trustTurnBuy
  combinedBuy
  trustTurnSell
  combinedSell
}

/// 籌碼集中度動態訊號：轉強 / 持平 / 轉弱（docs/wolftrack-tw-spec.md 3.6）
enum ChipMomentum {
  strengthening
  neutral
  weakening
}

/// 技術面 vs 籌碼面交叉驗證徽章（docs/wolftrack-tw-spec.md 3.6）
enum ChipBadge {
  confirmed
  divergence
}

/// 每股每日一筆的 Core Score + 三段分類計算結果（US + TW 共用，TW 專屬欄位皆為 nullable）
model DailyTrendSignal {
  id        BigInt   @id @default(autoincrement())
  stockId   Int      @map("stock_id")
  tradeDate DateTime @map("trade_date") @db.Date

  // 當日原始行情與技術指標（計算 Core Score / 分類邏輯所需，也供個股頁未來畫圖用）
  // TW 版這裡存的是還原股價後的值（見 adjustPrice()），不是原始收盤價
  closePrice   Decimal  @map("close_price") @db.Decimal(12, 4)
  volume       BigInt?
  ma20         Decimal? @db.Decimal(12, 4)
  ma50         Decimal? @db.Decimal(12, 4)
  ma200        Decimal? @db.Decimal(12, 4)
  rsi14        Decimal? @db.Decimal(6, 2)
  adx14        Decimal? @db.Decimal(6, 2)
  macdHist     Decimal? @map("macd_hist") @db.Decimal(12, 6)
  avgVolume20d Decimal? @map("avg_volume_20d") @db.Decimal(16, 2)

  // Core Score（0-100）與五個子分數，子分數保留供之後除錯/調權重用
  // US：coreScore = 5 因子加權；TW：coreScore = 0.5*technicalScore + 0.5*chipScore（technicalScore 才是 5 因子加權）
  coreScore        Decimal  @map("core_score") @db.Decimal(5, 2)
  maScore          Decimal? @map("ma_score") @db.Decimal(5, 2)
  momentumScore    Decimal? @map("momentum_score") @db.Decimal(5, 2)
  adxScore         Decimal? @map("adx_score") @db.Decimal(5, 2)
  relStrengthScore Decimal? @map("rel_strength_score") @db.Decimal(5, 2)
  volumeScore      Decimal? @map("volume_score") @db.Decimal(5, 2)

  // TW 版籌碼面（docs/wolftrack-tw-spec.md 第三章），US 版永遠是 null
  technicalScore      Decimal?      @map("technical_score") @db.Decimal(5, 2)
  chipScore           Decimal?      @map("chip_score") @db.Decimal(5, 2)
  chipConcentration5  Decimal?      @map("chip_concentration_5") @db.Decimal(6, 2)
  chipConcentration10 Decimal?      @map("chip_concentration_10") @db.Decimal(6, 2)
  chipConcentration20 Decimal?      @map("chip_concentration_20") @db.Decimal(6, 2)
  chipMomentum        ChipMomentum? @map("chip_momentum")
  chipBadge           ChipBadge?    @map("chip_badge")

  // 三段分類結果
  status TrendStatus

  // 反轉錨點：最近一次 MA20/50 黃金(死亡)交叉日期與當日收盤價
  // 用來算「趨勢變化後漲跌幅」= (closePrice - priceAtSignal) / priceAtSignal
  // 三種狀態下都會有值（不只是 reversal 狀態），代表目前這波趨勢是從哪天開始的
  reversalPointDate DateTime? @map("reversal_point_date") @db.Date
  priceAtSignal     Decimal?  @map("price_at_signal") @db.Decimal(12, 4)

  /// 2026-08-07新增：台股entry/exit/buyDip今天為什麼被分類進這個狀態，用當下實際數值描述
  /// （非規則本身），見 classifyChipFlow.ts 的 describeEntryReason/describeExitReasons/
  /// describeBuyDipReason。美股版跟台股 limitMove/none 狀態永遠是 null。
  triggerReason String? @map("trigger_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, tradeDate])
  @@index([tradeDate, status])
  @@index([stockId, tradeDate])
  @@map("daily_trend_signals")
}

/// 三大法人買賣超（docs/wolftrack-tw-spec.md 3.1），台股獨有
/// 張數與金額都存：spec 3.1 算 Chip Score 時外資用金額、投信用張數；3.6 算籌碼集中度兩者都用張數，單位不統一，兩種都存避免事後用不明確的換算去猜
model TwInstitutionalTrading {
  id        BigInt   @id @default(autoincrement())
  stockId   Int      @map("stock_id")
  tradeDate DateTime @map("trade_date") @db.Date

  foreignNetBuyShares     BigInt  @default(0) @map("foreign_net_buy_shares")
  foreignNetBuyAmount     Decimal @default(0) @map("foreign_net_buy_amount") @db.Decimal(18, 0)
  investTrustNetBuyShares BigInt  @default(0) @map("invest_trust_net_buy_shares")
  investTrustNetBuyAmount Decimal @default(0) @map("invest_trust_net_buy_amount") @db.Decimal(18, 0)
  dealerNetBuyShares      BigInt  @default(0) @map("dealer_net_buy_shares")
  dealerNetBuyAmount      Decimal @default(0) @map("dealer_net_buy_amount") @db.Decimal(18, 0)

  /// 當日總成交量（張），籌碼集中度公式的分母
  totalVolumeShares BigInt @default(0) @map("total_volume_shares")

  createdAt DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, tradeDate])
  @@index([tradeDate])
  @@map("tw_institutional_trading")
}

/// 台股原始日線（未還原股價），TWSE 個股歷史 API 是「一檔一個月」顆粒度、回填成本高，
/// 這張表把抓過的價格快取下來，之後每日批次只要抓「今天」一天補進來、不用每次重新回填 2 年。
/// adjustPrice() 還原股價在計算當下才做，這裡存的是原始未還原值（跟 limitMove 判斷需要原始價格的理由一致）。
model TwDailyPrice {
  id        BigInt   @id @default(autoincrement())
  stockId   Int      @map("stock_id")
  tradeDate DateTime @map("trade_date") @db.Date

  open   Decimal @db.Decimal(12, 4)
  high   Decimal @db.Decimal(12, 4)
  low    Decimal @db.Decimal(12, 4)
  close  Decimal @db.Decimal(12, 4)
  volume BigInt

  createdAt DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, tradeDate])
  @@index([stockId, tradeDate])
  @@map("tw_daily_price")
}

/// 個股本益比/股價淨值比/殖利率快照（docs/wolftrack-tw-spec.md 第四章供應鏈估值比較用），台股獨有
/// 只存「當下」快照，不需要像股價一樣回填歷史——Module C 的估值百分位比較只看目前的 PE/PB
model TwStockFundamentals {
  id        BigInt   @id @default(autoincrement())
  stockId   Int      @map("stock_id")
  tradeDate DateTime @map("trade_date") @db.Date

  pe            Decimal? @db.Decimal(10, 2)
  pb            Decimal? @db.Decimal(10, 2)
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, tradeDate])
  @@map("tw_stock_fundamentals")
}

/// 月營收（2026-07-11 新增）：TWSE/TPEx OpenAPI 的 t187ap05 系列端點只回傳「最新一期」快照，
/// 不能查歷史區間，所以每個月固定會抓到同一期資料 upsert 覆蓋，多月趨勢是靠每天/每月排程
/// 跑過去、資料庫裡自然累積出來的，不是一次回填的（跟 TwStockFundamentals 的 PE/PB 架構一致）。
model TwMonthlyRevenue {
  id           BigInt   @id @default(autoincrement())
  stockId      Int      @map("stock_id")
  /// 資料所屬月份的第一天，例如 2026-05-01 代表民國115年05月
  revenueMonth DateTime @map("revenue_month") @db.Date

  /// 當月營收（千元）
  revenue                   BigInt   @map("revenue")
  revenuePriorMonth         BigInt?  @map("revenue_prior_month")
  revenueSameMonthLastYear  BigInt?  @map("revenue_same_month_last_year")
  /// 月增率(%)
  momGrowthPct              Decimal? @map("mom_growth_pct") @db.Decimal(8, 2)
  /// 年增率(%)——台股投資人最常看的營收指標
  yoyGrowthPct              Decimal? @map("yoy_growth_pct") @db.Decimal(8, 2)
  cumulativeRevenue         BigInt?  @map("cumulative_revenue")
  cumulativeRevenueLastYear BigInt?  @map("cumulative_revenue_last_year")
  /// 累計營收年增率(%)
  cumulativeYoyGrowthPct    Decimal? @map("cumulative_yoy_growth_pct") @db.Decimal(8, 2)

  createdAt DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, revenueMonth])
  @@index([revenueMonth])
  @@map("tw_monthly_revenue")
}

/// 券商分點進出（docs/wolftrack-tw-spec.md 3.4），台股獨有
/// 這次先建表結構，「主力券商進駐」偵測邏輯之後再接（資料供應商尚未確認，見 spec 待確認清單第3項）
model TwBrokerBranchFlow {
  id         BigInt   @id @default(autoincrement())
  stockId    Int      @map("stock_id")
  tradeDate  DateTime @map("trade_date") @db.Date
  brokerName String   @map("broker_name")

  buyShares  BigInt @default(0) @map("buy_shares")
  sellShares BigInt @default(0) @map("sell_shares")
  netShares  BigInt @default(0) @map("net_shares")

  createdAt DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, tradeDate, brokerName])
  @@index([tradeDate])
  @@map("tw_broker_branch_flow")
}

/// 台指期(TX)每日近月合約行情，市場層級資料（不對應到某一檔stock），用來算「期貨-現貨基差」——
/// 現貨端直接查 tw_daily_price 的 TAIEX 合成股票即可，這裡只存近月一般盤的期貨行情。
/// 資料源 openapi.taifex.com.tw/v1/DailyMarketReportFut，這支API只回傳「今天」的快照，
/// 沒有歷史範圍可查，只能每天排程累積（見 runTaifexDailyUpdate.ts），沒有回填捷徑。
model TwFuturesDaily {
  id            BigInt   @id @default(autoincrement())
  tradeDate     DateTime @map("trade_date") @db.Date
  contract      String   @default("TX")
  contractMonth String   @map("contract_month")

  open            Decimal  @db.Decimal(10, 2)
  high            Decimal  @db.Decimal(10, 2)
  low             Decimal  @db.Decimal(10, 2)
  close           Decimal  @db.Decimal(10, 2)
  settlementPrice Decimal? @map("settlement_price") @db.Decimal(10, 2)
  volume          Int
  openInterest    Int      @map("open_interest")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([contract, tradeDate])
  @@map("tw_futures_daily")
}

/// 台指選擇權 Put/Call 比（買權/賣權成交量與未平倉量比值），市場層級資料。資料源
/// openapi.taifex.com.tw/v1/PutCallRatio 這支本身就回傳約一個月的歷史範圍，每天呼叫時
/// 用upsert疊加，自然累積出比 tw_futures_daily 更長的歷史。
model TwOptionsPutCallRatio {
  id        BigInt   @id @default(autoincrement())
  tradeDate DateTime @unique @map("trade_date") @db.Date

  putVolume             BigInt  @map("put_volume")
  callVolume            BigInt  @map("call_volume")
  putCallVolumeRatioPct Decimal @map("put_call_volume_ratio_pct") @db.Decimal(6, 2)
  putOpenInterest       BigInt  @map("put_open_interest")
  callOpenInterest      BigInt  @map("call_open_interest")
  putCallOiRatioPct     Decimal @map("put_call_oi_ratio_pct") @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("tw_options_put_call_ratio")
}

/// 逐字稿來源：caption=官方/自動字幕（游庭皓頻道有）、whisper=語音轉文字（EBC/Gooaye沒有字幕，走這條）
enum TranscriptSource {
  caption
  whisper
}

/// LLM 從逐字稿判讀出的個股情緒
enum MentionSentiment {
  bullish
  bearish
  neutral
}

/// 影片情緒 vs 系統當下 TrendStatus 的交叉比對結果。TrendStatus 完全沒有看空分類，
/// 所以 bearish/neutral 一律 noData（無從比較）；bullish 時，系統當下有訊號=agree，
/// 沒有訊號=aheadOfSystem（網紅已經看多但系統還沒亮燈，這才是最有價值的落差案例，
/// 不叫 disagree 避免誤導成「系統判斷錯誤」）。
enum MentionAgreement {
  agree
  aheadOfSystem
  noData
}

/// YouTube 財經頻道影片（2026-07-13新增）：頻道清單是 src/config/youtubeChannels.ts 裡
/// 固定的3個頻道（少量、手動維護，比照 group_config.json 的做法，不建 DB table）。
///
/// 2026-07-15改版：YouTube本身（yt-dlp）在雲端環境（GitHub Actions、Zeabur）一律被反機器人
/// 機制擋下（"Sign in to confirm you're not a bot"），cookies/PO Token/代理都試過仍被擋，
/// 改成從這3個節目對應的Podcast RSS feed抓取（SoundOn/SoundCloud等標準podcast host，
/// 沒有反爬蟲機制）。channelId/videoId欄位保留原名（避免大改schema/API路徑），語意變成
/// 「podcast節目slug」/「episode guid」；新增audioUrl存實際的MP3下載連結。
/// 新集數先用podcast RSS feed發現（stub row，transcript 為 null），語音轉文字在
/// Zeabur container內用faster-whisper跑完後回填，再觸發 LLM 解析出 mentions。
model YoutubeVideo {
  id                 Int               @id @default(autoincrement())
  channelId          String            @map("channel_id")
  videoId            String            @unique @map("video_id")
  title              String
  publishedAt        DateTime          @map("published_at")
  /// Podcast episode的MP3直接下載連結（discovery當下抓到的，用來給轉錄步驟下載音檔）
  audioUrl           String?           @map("audio_url")
  transcript         String?           @db.Text
  transcriptSource   TranscriptSource? @map("transcript_source")
  /// 擷取失敗次數，超過3次不再重試（保護運算資源）
  transcriptAttempts Int               @default(0) @map("transcript_attempts")
  transcriptFailedAt DateTime?         @map("transcript_failed_at")
  /// LLM 判讀出的整體市場看法摘要
  summary            String?           @db.Text
  /// LLM 額外整理出的3-5條具體關鍵訊號/數據重點，逐字稿內容空洞時可能是空陣列
  keySignals         String[]          @default([]) @map("key_signals")
  processedAt        DateTime?         @map("processed_at")
  /// 2026-07-21新增：LLM解析失敗次數，超過3次不再重試。原本解析是在ingest-transcript裡
  /// fire-and-forget觸發，依賴Zeabur container活到背景Promise跑完，production實測成功率
  /// 只有約1成——改成跟transcribe一樣由GitHub Actions排程驅動、awaited呼叫，這兩個欄位讓
  /// 這個retry loop可以安全地被重複觸發而不會無限重試已知會失敗的逐字稿
  parseAttempts      Int               @default(0) @map("parse_attempts")
  parseFailedAt      DateTime?         @map("parse_failed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  mentions YoutubeStockMention[]

  @@index([channelId, publishedAt])
  @@index([processedAt])
  @@map("youtube_videos")
}

/// 單支影片裡提到的個股（2026-07-13新增）。stockId 為 null 代表：FinMind 比對出0筆或2筆以上
/// 候選，無法自動判定，保留在 resolutionNote 供人工比對（比照既有的 seedTw.ts 驗證方式），
/// 不做 fuzzy match 硬猜。US 個股提及一律不自動新增，只比對已追蹤清單。
model YoutubeStockMention {
  id               BigInt            @id @default(autoincrement())
  videoId          Int               @map("video_id")
  stockId          Int?              @map("stock_id")
  /// LLM 逐字擷取出的原始個股名稱或代號（未經正規化）
  rawNameOrTicker  String            @map("raw_name_or_ticker")
  sentiment        MentionSentiment
  reasoningExcerpt String            @map("reasoning_excerpt") @db.Text
  /// 2026-07-16新增：LLM整理出的進場理由（例如「季報優於預期、法人開始加碼」），
  /// 逐字稿沒有明確提到就是null，不要求每個mention都硬湊一個
  entryReason      String?           @map("entry_reason") @db.Text
  /// 出場條件（例如「跌破月線」「本益比超過20倍」「達到目標價後」），同樣沒提到就是null
  exitCondition    String?           @map("exit_condition") @db.Text
  isNewStock       Boolean           @default(false) @map("is_new_stock")
  /// stockId 為 null 時，記錄無法自動判定的原因（例如「FinMind比對到2筆候選」）
  resolutionNote   String?           @map("resolution_note")
  /// 交叉比對當下（mention 建立時）的系統 TrendStatus 快照，之後不會重算
  systemStatus     TrendStatus?      @map("system_status")
  agreement        MentionAgreement? @map("agreement")
  createdAt        DateTime          @default(now()) @map("created_at")

  video YoutubeVideo @relation(fields: [videoId], references: [id])
  stock Stock?       @relation(fields: [stockId], references: [id])

  @@index([videoId])
  @@index([stockId])
  @@map("youtube_stock_mentions")
}

/// 2026-07-25新增：追蹤「price/institutional/revenue 這三種資料各自回補到10年歷史的進度」，
/// 避免每天排程重跑時，對已經回補到FinMind能提供的最早日期（例如新掛牌股票沒有更早資料）
/// 的股票，每次都白白浪費一次API呼叫去重新確認「還是沒有更早的資料」。
/// isFullyBackfilled=true 代表「已經回補到TARGET_START_DATE，或已經確認FinMind沒有更早
/// 的資料了」，之後排程會跳過這筆，不會再消耗API額度。
model TwHistoryBackfillStatus {
  id      Int    @id @default(autoincrement())
  stockId Int    @map("stock_id")
  /// "price" | "institutional" | "revenue"
  dataset String

  earliestDateFetched DateTime? @map("earliest_date_fetched") @db.Date
  isFullyBackfilled   Boolean   @default(false) @map("is_fully_backfilled")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, dataset])
  @@map("tw_history_backfill_status")
}

/// 法說會基本面訊號整體評估：正面(獲利成長+展望樂觀)/中性/負面(獲利衰退或風險升高)
enum FundamentalSignal {
  positive
  neutral
  negative
}

/// 2026-07-25新增：龍頭股法說會（MOPS公開資訊觀測站，見 mopsClient.ts）簡報PDF的LLM解析結果。
/// 只涵蓋 group_config.json 裡各theme標記的leader股票（目前48檔），不是全市場——法說會一季
/// 一次，全市場等級的量太大也沒必要，龍頭股的展望/風險最能代表整條產業鏈的方向。
model EarningsCallAnalysis {
  id      Int @id @default(autoincrement())
  stockId Int @map("stock_id")

  conferenceDate DateTime @map("conference_date") @db.Date
  /// MOPS的中文簡報檔名（例如233020260716M001.pdf），拿來判斷這場法說會有沒有處理過，避免重複
  pdfFileName    String   @unique @map("pdf_file_name")

  /// LLM整理的獲利成長重點（營收/毛利率/淨利等數字與趨勢），簡報沒提到具體數字就描述定性判斷
  profitGrowthSummary String            @map("profit_growth_summary") @db.Text
  /// 下一季/下一年度的展望與guidance
  outlookSummary      String            @map("outlook_summary") @db.Text
  /// 簡報裡提到的具體風險因素，不是Safe Harbor那種制式法律免責聲明
  riskSummary         String            @map("risk_summary") @db.Text
  signal              FundamentalSignal

  createdAt DateTime @default(now()) @map("created_at")

  stock Stock @relation(fields: [stockId], references: [id])

  @@index([stockId])
  @@map("earnings_call_analyses")
}

/// 台指期 Decision OS 最終立場（見 docs/taifex-decision-os-prd.html 第6節）
enum FinalStance {
  bull
  bear
  neutral
}

/// 台指期 Decision OS 建議策略
enum TradeStrategy {
  swingLong
  swingShort
  rangeBound
  flat
}

/// 台指期 Decision OS 風險等級
enum RiskLevel {
  low
  medium
  high
}

/// 台指期 Decision OS 每日決策快照：八層分數 + 最終建議，一天一筆，/decision-os 頁面直接讀這張表。
/// MVP階段只有 L3/L4/L6 有實際分數（資料源已驗證可用），L1/L2/L5 欄位保留供第二階段接上後使用，
/// 目前先是 null（見 docs/taifex-decision-os-prd.html 第15節「資料源現況總表」的缺口說明）。
model DecisionSnapshot {
  id        BigInt   @id @default(autoincrement())
  tradeDate DateTime @unique @map("trade_date") @db.Date

  l1GlobalScore    Decimal? @map("l1_global_score") @db.Decimal(4, 2)
  l3TwMarketScore  Decimal? @map("l3_tw_market_score") @db.Decimal(4, 2)
  l4FlowScore      Decimal? @map("l4_flow_score") @db.Decimal(4, 2)
  l5SentimentScore Decimal? @map("l5_sentiment_score") @db.Decimal(4, 2)
  l6TechnicalScore Decimal? @map("l6_technical_score") @db.Decimal(4, 2)
  totalScore       Decimal  @map("total_score") @db.Decimal(5, 2)

  finalStance       FinalStance   @map("final_stance")
  finalConfidence   Int           @map("final_confidence")
  strategy          TradeStrategy
  riskLevel         RiskLevel     @map("risk_level")
  suggestedSizePct  Int           @map("suggested_size_pct")
  entryCondition    String        @map("entry_condition") @db.Text
  stopLossPrice     Decimal?      @map("stop_loss_price") @db.Decimal(10, 2)
  takeProfitPrice   Decimal?      @map("take_profit_price") @db.Decimal(10, 2)
  supportingReasons Json          @map("supporting_reasons")
  opposingReasons   Json          @map("opposing_reasons")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("decision_snapshots")
}

/// Gate 引擎每日觸發紀錄，一天可能多筆（每個觸發的Gate一筆），供Dashboard警示條與歷史稽核用
model GateTrigger {
  id         BigInt   @id @default(autoincrement())
  tradeDate  DateTime @map("trade_date") @db.Date
  gateNumber Int      @map("gate_number")
  gateName   String   @map("gate_name")
  action     String
  detail     String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tradeDate])
  @@map("gate_triggers")
}

/// 使用者風控設定：MVP先做單一全域設定（不分帳號），Onboarding流程與多使用者留給之後
model UserRiskProfile {
  id                  Int      @id @default(autoincrement())
  accountEquity       Decimal  @map("account_equity") @db.Decimal(14, 0)
  riskPerTradePct     Decimal  @default(1.0) @map("risk_per_trade_pct") @db.Decimal(4, 2)
  dailyMaxLossPct     Decimal  @default(3.0) @map("daily_max_loss_pct") @db.Decimal(4, 2)
  monthlyMaxLossPct   Decimal  @default(10.0) @map("monthly_max_loss_pct") @db.Decimal(4, 2)
  maxExposurePct      Decimal  @default(50.0) @map("max_exposure_pct") @db.Decimal(4, 2)
  atrStopMultiplier   Decimal  @default(1.5) @map("atr_stop_multiplier") @db.Decimal(3, 2)
  consecutiveLossHalt Int      @default(3) @map("consecutive_loss_halt")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("user_risk_profile")
}

/// 總體風險事件行事曆（L2 資料源），MVP階段人工維護，見 docs/taifex-decision-os-prd.html 第15節
model MacroEvent {
  id         Int      @id @default(autoincrement())
  eventDate  DateTime @map("event_date") @db.Date
  eventType  String   @map("event_type")
  label      String
  gateAction String   @map("gate_action")

  @@index([eventDate])
  @@map("macro_events")
}

/// Decision Lab（總經頁最上方，見 docs/decision-lab-prd.html）Regime分類，第7節定義
enum MarketRegime {
  strongBull
  weakBull
  range
  weakBear
  strongBear
  volatile
  distribution
  accumulation
  capitulation
}

/// Decision Lab 每日快照：M1全球市場 + M7 Regime + M8 Trading Score，一天一筆。
/// Phase 1 只有 globalMarketData/volatilityData(VIX)/liquidityData(沿用既有PCR) 有實際內容，
/// macroEvents/breadthData/sentimentData 留到資料源補齊後再填，目前是null——不假裝有資料，
/// scoreBreakdown 會誠實記錄哪些因子因為沒資料而貢獻0分，見 docs/decision-lab-prd.html 第14節。
model MacroDailySnapshot {
  id           BigInt   @id @default(autoincrement())
  snapshotDate DateTime @unique @map("snapshot_date") @db.Date

  globalMarketData Json  @map("global_market_data")
  macroEvents      Json? @map("macro_events_snapshot")
  volatilityData   Json? @map("volatility_data")
  liquidityData    Json? @map("liquidity_data")
  breadthData      Json? @map("breadth_data")
  sentimentData    Json? @map("sentiment_data")

  regime           MarketRegime
  tradingScore     Int          @map("trading_score")
  maxPossibleScore Int          @map("max_possible_score")
  scoreBreakdown   Json         @map("score_breakdown")

  tradingPlanStrategy String @map("trading_plan_strategy")
  tradingPlanReason   String @map("trading_plan_reason") @db.Text
  suggestedSizePct    Int    @map("suggested_size_pct")

  fundManagerNote String? @map("fund_manager_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@map("macro_daily_snapshots")
}

enum ScenarioOutcome {
  correct
  incorrect
  notTriggered
}

/// Decision Lab M9 情境生成器：每天三個劇本，收盤後（Phase 2 Decision Replay）回填 actualOutcome
model ScenarioForecast {
  id           BigInt   @id @default(autoincrement())
  snapshotDate DateTime @map("snapshot_date") @db.Date
  label        String
  description  String   @db.Text
  probability  Int
  condition    String   @db.Text
  risk         String   @db.Text
  strategy     String   @db.Text

  actualOutcome ScenarioOutcome? @map("actual_outcome")

  @@unique([snapshotDate, label])
  @@map("scenario_forecasts")
}

/// 預期差三大切入點，見docs分享的「法人級投資研究體系與實戰導航手冊」第四節
enum VarianceDriver {
  capacityYield
  productMixAsp
  inventoryCycle
  other
}

enum ExpectationGapStatus {
  active
  confirmed
  invalidated
}

/// 預期差研究筆記：Variance = 自己的Proprietary Model估值 - 市場共識，這是法人研究部門的核心
/// 工作方法，不是backtest也不是自動訊號——記錄「我跟市場共識的判斷哪裡不一樣、為什麼」，
/// 事後才知道這個差異判斷得準不準。跟Trade Log分開是因為一筆研究判斷不一定會變成一筆交易
/// （也可能觀察後發現預期差不成立、根本沒進場），兩者是「判斷」跟「執行」兩個不同階段。
model ExpectationGapNote {
  id     BigInt @id @default(autoincrement())
  market Market
  ticker String

  noteDate     DateTime @map("note_date") @db.Date
  currentPrice Decimal  @map("current_price") @db.Decimal(12, 2)

  consensusEps         Decimal? @map("consensus_eps") @db.Decimal(10, 2)
  consensusTargetPrice Decimal? @map("consensus_target_price") @db.Decimal(12, 2)

  ownEps      Decimal? @map("own_eps") @db.Decimal(10, 2)
  ownTargetPe Decimal? @map("own_target_pe") @db.Decimal(6, 2)

  varianceDriver VarianceDriver @map("variance_driver")
  thesis         String         @db.Text

  status      ExpectationGapStatus @default(active)
  outcomeNote String?              @map("outcome_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([market, ticker])
  @@index([status])
  @@map("expectation_gap_notes")
}

enum TradeSide {
  long
  short
}

enum TradeStatus {
  open
  closed
  cancelled
}

/// 這筆交易的靈感來源，用來事後做績效歸因（例如「trend entry訊號實際賺錢嗎」不能只看
/// backtest，要看使用者真的照訊號進出場的紀錄）。跟TacticalStatus/regime脫鉤成獨立enum，
/// 是因為Trade Log要長期累積，不該因為訊號分類邏輯改名就要backfill舊資料。
enum TradeSignalSource {
  twTrendEntry
  twTrendBuyDip
  twTrendReversal
  twTrendPullback
  twTrendBullish
  decisionOsFutures
  decisionLabGlobal
  expectationGap
  manual
}

/// 使用者手動記錄的真實進出場，不是任何策略自動產生——這是所有backtest/訊號研究最終
/// 要對照的「真實有沒有照著做、做了有沒有賺錢」基準線，見專業經理人角度review第3點。
model TradeLogEntry {
  id     BigInt @id @default(autoincrement())
  market Market
  ticker String

  side         TradeSide
  signalSource TradeSignalSource? @map("signal_source")

  entryDate  DateTime @map("entry_date") @db.Date
  entryPrice Decimal  @map("entry_price") @db.Decimal(12, 2)
  quantity   Decimal  @db.Decimal(14, 2)

  exitDate  DateTime? @map("exit_date") @db.Date
  exitPrice Decimal?  @map("exit_price") @db.Decimal(12, 2)

  stopLossPrice   Decimal? @map("stop_loss_price") @db.Decimal(12, 2)
  takeProfitPrice Decimal? @map("take_profit_price") @db.Decimal(12, 2)

  status TradeStatus @default(open)
  notes  String?     @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([market, ticker])
  @@index([status])
  @@map("trade_log_entries")
}
